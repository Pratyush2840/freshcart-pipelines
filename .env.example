# FreshCart Pipelines - Environment Template
# Copy this file to `.env` and populate your credentials (never commit `.env`).

# Snowflake Warehouse Configuration (Part B & Bonus)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=FRESHCART_WH
SNOWFLAKE_DATABASE=FRESHCART
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=ACCOUNTADMIN

# RabbitMQ / CloudAMQP Connection URL (Part D & Bonus)
# Local Docker : amqp://guest:guest@localhost:5672/
# CloudAMQP    : amqps://username:password@hostname/vhost
AMQP_URL=amqp://guest:guest@localhost:5672/
